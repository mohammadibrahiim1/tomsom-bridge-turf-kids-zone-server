// ==========================================
// ENUMS
// ==========================================

enum SportType {
  FOOTBALL
  CRICKET
  BADMINTON
  KIDS_ZONE
}

enum GroundType {
  PITCH_1_SMALL
  PITCH_2_LARGE
}

enum SlotTimeType {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  LOCKED       // Temporarily held during checkout
  MAINTENANCE
}

// ==========================================
// MODELS
// ==========================================

/// Model representing customizable time slots for various turf packages
model Slot {
  id                    String        @id @default(uuid())
  slotId                String        @unique // Unique system generated slot identifier (e.g., "CRICKET-EVENING-1800")

  // Ground / Pitch details
  groundType            GroundType    @default(PITCH_1_SMALL)
  groundTypeBn          String?       @default("মাঠ ১ (ছোট মাঠ)") // Ground name in Bengali

  // Sport information
  sportType             SportType     @default(FOOTBALL)
  sportTypeBn           String?       // Sport name in Bengali (e.g., "ফুটবল টার্ফ")

  // Package information
  packageNumber         Int?          // Package ID (1, 2, 3, 4, 5)
  packageName           String?       // Package Name (e.g., "প্যাকেজ ০১ (ছোট মাঠ)")

  // Timing details
  startTime             String        // 24-hour format (e.g., "18:00")
  endTime               String        // 24-hour format (e.g., "19:00")
  displayTime           String        // UI display string (e.g., "06:00 PM - 07:00 PM")
  bookingDate           DateTime?     // Specific date for dynamic slot generation

  playDurationMinutes   Int           @default(55) // Active gameplay time in minutes
  bufferDurationMinutes Int           @default(5)  // Turnaround/cleaning buffer time in minutes


  hasExtraTime        Boolean   @default(false)
  extraTimeMinutes    Int       @default(0)
  extraTimeCharge     Float     @default(0)

  slotType              SlotTimeType  @default(EVENING)
  slotTypeBn            String?       // Time period in Bengali ("সকাল", "সন্ধ্যা", etc.)

  // Pricing details
  regularPrice          Float         // Base slot price
  extraGroundCharge     Float         @default(200) // Additional charge for larger pitch (Pitch 2)
  totalPrice            Float         // Final calculated price
  peakPrice             Float?        // Peak hour pricing override
  weekendPrice          Float?        // Weekend pricing override

  // Special facilities & amenities
  isNightMatch          Boolean       @default(false) // Includes floodlight coverage
  hasRainEffect         Boolean       @default(false) // Includes artificial rain feature
  hasSoundSystem        Boolean       @default(false) // Includes sound system facility
  includedAmenities     String[]      @default([])    // Array of freebies e.g. ["Jersey", "Gloves", "Water"]

  // Flexible future attributes
  customAttributes      Json?         // Extensible JSON for future dynamic metadata

  // Status & Control
  status                SlotStatus    @default(AVAILABLE)
  isActive              Boolean       @default(true)  // Soft delete / activation toggle

  // System Timestamps
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Indexes for fast querying
  @@index([sportType])
  @@index([groundType])
  @@index([status])
  @@index([bookingDate])
  @@map("slots")
}